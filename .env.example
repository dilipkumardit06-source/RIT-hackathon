# ==============================================================
# OPTIGOAL ENGINE - AWS BEDROCK & AI ADVISOR CONFIGURATION
# ==============================================================

# Option 1: AWS Bedrock Playground Bearer Token (from Bedrock Playground "View API Request")
# Note: Playground tokens typically expire after 12-48 hours.
AWS_BEARER_TOKEN_BEDROCK="bedrock-api-key-YOUR_PLAYGROUND_TOKEN_HERE"

# Option 2: Standard AWS IAM Access Keys (Recommended for permanent production use)
# Create in AWS Console -> IAM -> Users -> Security Credentials -> Create Access Key
AWS_ACCESS_KEY_ID="your_aws_access_key_id"
AWS_SECRET_ACCESS_KEY="your_aws_secret_access_key"
# (Optional: include AWS_SESSION_TOKEN if using temporary STS/SSO credentials)
# AWS_SESSION_TOKEN=""

# AWS Region where your Bedrock model access is enabled (e.g. eu-north-1, us-east-1, ap-south-1)
AWS_REGION="eu-north-1"

# Option 3: OpenRouter API Key for Chatbot (Claude, GPT-4o, Llama)
# Obtain from https://openrouter.ai/keys
OPENROUTER_API_KEY="sk-or-v1-YOUR_OPENROUTER_KEY_HERE"
